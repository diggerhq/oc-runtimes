{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022"], "types": ["node"], "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
